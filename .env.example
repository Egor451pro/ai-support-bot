BOT_TOKEN=your_telegram_bot_token

# Local: polling. Render free: webhook (keeps webhook across container sleeps).
MODE=polling

# Supabase → Project Settings → Database → Connect → URI
# Replace PASSWORD and PROJECT_REF. Driver must be postgresql+asyncpg.
# Direct (port 5432):
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Pooler example (port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Encode special chars in password: @=%40  :=%3A  /=%2F  #=%23

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
SUPPORT_GROUP_CHAT_ID=-1001234567890

# Required when MODE=webhook (Render public HTTPS URL, no trailing slash).
# WEBHOOK_BASE_URL=https://your-app.onrender.com
WEBHOOK_BASE_URL=

# Required when MODE=webhook. Must match [A-Za-z0-9_-]{1,256}.
# Path becomes /webhook/{WEBHOOK_SECRET}; also sent as Telegram secret_token.
# WEBHOOK_SECRET=change_me_to_a_long_random_string
WEBHOOK_SECRET=

HOST=0.0.0.0
PORT=8000
